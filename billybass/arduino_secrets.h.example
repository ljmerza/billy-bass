// Home Assistant / MQTT. Leave the host empty to disable MQTT entirely.
#define SECRET_MQTT_HOST ""
#define SECRET_MQTT_PORT 1883
#define SECRET_MQTT_USER ""
#define SECRET_MQTT_PASS ""
